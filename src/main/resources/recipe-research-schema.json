{
  "name": "recipes",
  "type": "json_schema",
  "strict": true,
  "schema": {
    "type": "object",
    "properties": {
      "recipes": {
        "type": "array",
        "description": "A list of recipe objects, each with a url, description, and detailed attributes.",
        "items": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "description": "The recipe's canonical URL.",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "description": "A plain-language description of the recipe.",
              "minLength": 1
            },
            "details": {
              "$ref": "#/$defs/recipe_details"
            }
          },
          "required": [
            "url",
            "description",
            "details"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "recipes"
    ],
    "additionalProperties": false,
    "$defs": {
      "recipe_details": {
        "type": "object",
        "properties": {
          "dishType": {
            "type": "string",
            "description": "The type of dish requested (e.g. beef stew, pasta, salad).",
            "minLength": 1
          },
          "appliances": {
            "type": "array",
            "description": "Array of appliances to mention or require for the dish.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "ingredients": {
            "type": "array",
            "description": "Array of ingredients to mention, include, or exclude.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "nutrition": {
            "type": "array",
            "description": "Nutrition details or requests (e.g. low sodium, high protein).",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cuisineTypes": {
            "type": "array",
            "description": "Cuisine type(s) requested (e.g. Italian, French, Japanese).",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "dishType",
          "appliances",
          "ingredients",
          "nutrition",
          "cuisineTypes"
        ],
        "additionalProperties": false
      }
    }
  }
}